NODE_ENV=<development|test|production>
PORT=<port>
MONGODB_URI=mongodb://<username>:<password>@<host>:<port>/<database>
MONGODB_TEST_URI=mongodb://<username>:<password>@<local-replica-set-host>:<port>/stockly_test?replicaSet=rs0
SESSION_SECRET=<generate-a-random-secret-at-least-32-characters>
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=5000
RESTOCKING_PLANNING_HORIZON_DAYS=7
RESTOCKING_SAFETY_BUFFER_DAYS=2
CORS_ORIGIN=<frontend-origin>